# ============================================================
# DebateWatcher – Environment Configuration Template
# Copy to .env and fill in values for your local setup.
# ============================================================

# ---- OBS WebSocket ----------------------------------------
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=your_obs_websocket_password_here

# ---- Ollama (local LLM server) ----------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OLLAMA_ANALYSIS_TEMPERATURE=0.2
OLLAMA_TIMEOUT=30

# ---- Whisper / Transcription ------------------------------
# Backend: "faster-whisper" or "whisper-cpp"
WHISPER_BACKEND=faster-whisper
# Model size: tiny.en | base.en | small.en | medium.en
WHISPER_MODEL=base.en
# Hardware device: cpu | cuda | auto
WHISPER_DEVICE=auto
# Compute type: float32 | float16 | int8
WHISPER_COMPUTE_TYPE=float16

# ---- Audio Capture ----------------------------------------
# Name of the audio input device (leave blank to use system default)
AUDIO_DEVICE=
# Sample rate in Hz (Whisper expects 16000)
AUDIO_SAMPLE_RATE=16000
# Chunk duration in seconds for the sliding window buffer
AUDIO_CHUNK_SECONDS=4
# Overlap between consecutive chunks (seconds)
AUDIO_CHUNK_OVERLAP=0.5

# ---- Speaker Diarization ----------------------------------
# Enable pyannote speaker diarization (requires HuggingFace token)
DIARIZATION_ENABLED=false
HF_AUTH_TOKEN=your_huggingface_token_here

# ---- Vector Database (ChromaDB) ---------------------------
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION=debate_transcripts

# ---- SQLite state store -----------------------------------
SQLITE_PATH=./data/debate_watcher.db

# ---- Overlay WebSocket server -----------------------------
OVERLAY_HOST=0.0.0.0
OVERLAY_PORT=8765

# ---- Analysis pipeline thresholds ------------------------
# Minimum confidence score (0.0–1.0) to surface a fallacy alert in the database
FALLACY_CONFIDENCE_THRESHOLD=0.65
# Higher threshold to auto-push an alert to OBS without human approval
# Alerts between FALLACY_CONFIDENCE_THRESHOLD and this value appear in the
# research dashboard for a human to approve before being streamed.
OBS_PUSH_CONFIDENCE_THRESHOLD=0.75
# Seconds of silence before the diarizer emits a segment boundary
VAD_SILENCE_THRESHOLD=0.6
# Directory containing .txt/.md reference documents for local fact-checking
KNOWLEDGE_BASE_DIR=./knowledge_base

# ---- Logging ----------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./data/debate_watcher.log
